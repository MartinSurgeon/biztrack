<?xml version="1.0" encoding="utf-8"?>
<!-- The local database holds the SMS API key and cloud sync secret, so it is kept out of cloud backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
