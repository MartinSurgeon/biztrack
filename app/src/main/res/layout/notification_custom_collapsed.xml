<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_stat_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Badge Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/notif_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_naadriel_logo"
            android:contentDescription="Naadriel Farm" />

        <TextView
            android:id="@+id/notif_header_tag"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="NAADRIEL ENTERPRISE • SALES"
            android:textColor="#1B5E20"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Just now"
            android:textColor="#748A74"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Main Content Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notif_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sale Order #INV-1002"
                android:textColor="#1A201A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Kofi Mensah • 10 Crates Large Eggs"
                android:textColor="#4A554A"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Highlight Amount Badge -->
        <LinearLayout
            android:id="@+id/notif_amount_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_button_secondary_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/notif_amount_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GH₵ 450.00"
                android:textColor="#1B5E20"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
